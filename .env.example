# Copy to .env and fill in. Never commit .env.

# Fine-grained personal access token, read-only. See README "Create a token".
GITHUB_TOKEN=

# Optional
# PULSE_PORT=8080          # host port for docker compose
# PULSE_CACHE_TTL=10m      # how long GitHub data is reused before refetching
# PULSE_LOOKBACK_DAYS=90   # overrides lookback_days in projects.json
